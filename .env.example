# ---------------------------------------------------------------------------
# Database — Postgres
#
# Replaced local SQLite when this moved to serverless hosting: those
# filesystems are read-only and ephemeral, and the suppression list must
# survive. Losing it makes previously-bounced addresses mailable again.
#
# Use the POOLED connection string. Serverless spins up many short-lived
# instances and a direct connection will exhaust the server's limit.
#   Neon     : the "-pooler" host
#   Supabase : port 6543, not 5432
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# AI — Google Gemini
#
# GEMINI_API_KEYS accepts one key, or several comma-separated. Multiple keys
# are round-robined to spread per-key rate limits — worth it for the drafting
# pass, which makes one call per lead.
#
# The two agents differ by model: the ICP agent (once per company) uses the
# main model; the drafting agent (once per lead) uses the fast model.
# ---------------------------------------------------------------------------
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Lead sourcing — two stages
#   Exa    : web search that discovers companies matching the ICP
#   Hunter : finds contactable people (with emails) at each company's domain
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=exa
EXA_API_KEY=

HUNTER_API_KEY=

# ---------------------------------------------------------------------------
# Sending — your own professional mailbox over SMTP
#
#   Google Workspace : smtp.gmail.com        : 587 : App Password (needs 2FA on)
#   Microsoft 365    : smtp.office365.com    : 587 : mailbox password / app password
#   Zoho Mail        : smtp.zoho.com         : 587
#
# SMTP_USER is the account you authenticate as. SMTP_FROM is what recipients
# see — for most providers it must match SMTP_USER or be a verified alias.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourcompany.com
SMTP_PASS=
SMTP_FROM_NAME=Your Name
SMTP_FROM=you@yourcompany.com
SMTP_REPLY_TO=

# ---------------------------------------------------------------------------
# Deliverability + compliance. Not optional decoration: a cold email without a
# working unsubscribe and a physical address is unlawful under CAN-SPAM, and
# burning your real domain's reputation is not reversible.
# ---------------------------------------------------------------------------
# Public base URL — unsubscribe links are built from this. Must be reachable
# by recipients, so localhost only works while you are testing against yourself.
APP_BASE_URL=http://localhost:3000

# Signs unsubscribe tokens. Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# Physical mailing address, required in the footer of every commercial email.
SENDER_POSTAL_ADDRESS=Acme Inc, 123 Example St, San Francisco, CA 94105, USA

# Mail addresses the verifier cannot confirm (accept-all domains, which answer
# yes to every address at the gateway and only reject at mailbox lookup — the
# one bounce verification cannot rule out). Keep false on a young domain.
SEND_TO_RISKY_ADDRESSES=false

# Throttle. A new domain should start near 20/day and ramp over ~4 weeks.
MAX_SENDS_PER_DAY=40
SECONDS_BETWEEN_SENDS=45
